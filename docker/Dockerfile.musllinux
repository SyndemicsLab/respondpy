ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG EIGEN_VERSION=3.4.0

RUN curl --fail --location --silent --show-error \
    "https://github.com/eigenteam/eigen-git-mirror/archive/refs/tags/${EIGEN_VERSION}.tar.gz" \
    --output /tmp/eigen.tar.gz \
    && mkdir -p /usr/local/include/eigen3 \
    && tar --extract --gzip --file /tmp/eigen.tar.gz --strip-components=1 --directory /usr/local/include/eigen3 \
    && rm /tmp/eigen.tar.gz
