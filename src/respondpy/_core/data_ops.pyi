class Writer:
    def __init__(self, directory: str, log_name: str) -> None: ...

    def write_input_data(self, data_loader: DataLoader,
                         directory: str, output_type: OutputType) -> str: ...

    def write_history_data(self, history: History,
                           directory: str, output_type: OutputType) -> str: ...

    def write_cost_data(
        self, cost_list: list[Cost], directory: str, output_type: OutputType) -> str: ...

    def write_utility_data(
        self, utilities: dict[int, np.ndarray], directory: str, output_type: OutputType) -> str: ...

    def write_totals_data(self, totals: Totals, directory: str,
                          output_type: OutputType) -> str: ...
