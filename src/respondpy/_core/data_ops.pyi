class UtilityLoader:
    def __init__(self, directory: str, log_name: str) -> None: ...
    def load_background_utility(self, file: str) -> dict[str, np.ndarray]: ...
    def load_oud_utility(self, file: str) -> dict[str, np.ndarray]: ...
    def load_setting_utility(self, file: str) -> dict[str, np.ndarray]: ...
    def get_background_utility(self, perspective: str) -> np.ndarray: ...
    def get_oud_utility(self, perspective: str) -> np.ndarray: ...
